# Shared settings for the backend and the frontend. Copy to .env (in this folder) and fill in.
# Backend variable names are case-insensitive.
#
# Vercel: this file is not deployed. Add the same variables under
# Project Settings -> Environment Variables. On Vercel you need at least
# MONGODB_URI and MONGODB_DB_NAME; leave VITE_API_BASE_URL empty (the API is on
# the same domain) and CORS_ORIGINS can stay as is.

# --- MongoDB -------------------------------------------------------
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI= mongodb+srv://syncaidevelopment_db_user:bl6mhRAPTskeWOFM@csr.6sbwcdt.mongodb.net/
MONGODB_DB_NAME=Palawi-CSR
# Fill empty collections with the bundled sample data on startup.
# On Vercel set this to false once the database has been seeded, to keep cold starts fast.
SEED_ON_STARTUP=true

# --- CORS ----------------------------------------------------------
# Comma-separated origins allowed to call the API from another domain (the Vite dev server by default).
# Not needed on Vercel, where the frontend and API share one domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Integrations (not used by any endpoint yet) -------------------
GEMINI_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Frontend (Vite) -----------------------------------------------
# Only variables starting with VITE_ reach the browser; nothing above is exposed.
# Where `npm run dev` forwards /api requests (the FastAPI server).
VITE_DEV_API_PROXY=http://localhost:8000
# Production builds only: the API's public origin when it is not served from
# the same domain as the frontend. Leave empty to call /api on the same origin (Vercel).
VITE_API_BASE_URL=
